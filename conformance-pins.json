{
  "$comment": "Single source of truth for the Gnosis-preset client-conformance setup. Bump deliberately. Per-client version matching: the clients track different upstream spec versions, so each is pinned to a frozen gnosischain-fork branch carrying the Gnosis spec-test wiring AND to the matching gnosischain/consensus-specs gnosis.tar.gz release ('vectorVersion'). 'ref' is the branch run by .github/workflows/client-conformance.yml.",
  "vectorRepo": "gnosischain/consensus-specs",
  "clients": {
    "lighthouse": {
      "repo": "gnosischain/lighthouse",
      "ref": "gnosis-conformance-alpha8",
      "vectorVersion": "v1.7.0-alpha.8",
      "command": "make test-ef-gnosis",
      "vectorVersionPin": "GNOSIS_SPECS_TEST_VERSION (testing/ef_tests/Makefile)"
    },
    "nimbus": {
      "repo": "gnosischain/nimbus-eth2",
      "ref": "gnosis-conformance-alpha10",
      "vectorVersion": "v1.7.0-alpha.10",
      "command": "make consensus_spec_tests_gnosis && scripts/setup_scenarios.sh && ./build/consensus_spec_tests_gnosis",
      "vectorVersionPin": "GNOSIS_SPECS_TEST_VERSION (scripts/setup_scenarios.sh)"
    },
    "teku": {
      "repo": "gnosischain/teku",
      "ref": "gnosis-conformance-alpha10",
      "vectorVersion": "v1.7.0-alpha.10",
      "command": "ENV_SPEC=gnosis ./gradlew :eth-reference-tests:referenceTest",
      "vectorVersionPin": "gnosisRefTestVersion (build.gradle)"
    },
    "lodestar": {
      "repo": "gnosischain/lodestar",
      "ref": "gnosis-conformance-alpha10",
      "vectorVersion": "v1.7.0-alpha.10",
      "command": "pnpm test:spec:gnosis",
      "vectorVersionPin": "gnosisConsensusSpecsTests.specVersion (spec-tests-version.json)"
    }
  }
}
